WITH normalized_queries AS (
    SELECT
        *,
        TRIM(
            REGEXP_REPLACE(
                REGEXP_REPLACE(
                    REGEXP_REPLACE(
                        UPPER(SqlTextInfo),
                        '/\\*.*?\\*/',
                        ''
                    ),
                    '--.*',
                    ''
                ),
                '\\s+',
                ' '
            )
        ) AS normalized_sql
    FROM master_table
    WHERE UPPER(Source) = 'DATABRICKS'
),

query_counts AS (
    SELECT
        *,
        COUNT(*) OVER (PARTITION BY normalized_sql) AS duplicate_count
    FROM normalized_queries
)

SELECT *
FROM query_counts
WHERE duplicate_count = (
    SELECT MAX(duplicate_count)
    FROM query_counts
)
ORDER BY LogDate, StartTime;
