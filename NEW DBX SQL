WITH normalized_queries AS (
    SELECT
        user_name,
        SqlTextInfo,
        LogDate,
        StartTime,
        LastResponseTime,
        ExecutionTime,
        Source,

        TRIM(
            REGEXP_REPLACE(
                REGEXP_REPLACE(
                    REGEXP_REPLACE(
                        UPPER(SqlTextInfo),

                        '/\\*.*?\\*/',      -- Remove block comments
                        ''
                    ),

                    '--.*',               -- Remove single-line comments
                    ''
                ),

                '\\s+',                  -- Replace multiple whitespace with one space
                ' '
            )
        ) AS normalized_sql

    FROM master_table
    WHERE UPPER(Source) = 'DATABRICKS'
),

duplicate_queries AS (
    SELECT
        normalized_sql,
        COUNT(*) AS duplicate_count
    FROM normalized_queries
    GROUP BY normalized_sql
),

top_duplicate AS (
    SELECT *
    FROM duplicate_queries
    ORDER BY duplicate_count DESC
    LIMIT 1
)

SELECT
    nq.user_name,
    nq.SqlTextInfo,
    nq.LogDate,
    nq.StartTime,
    nq.LastResponseTime,
    nq.ExecutionTime,
    nq.Source,
    td.duplicate_count
FROM normalized_queries nq
JOIN top_duplicate td
    ON nq.normalized_sql = td.normalized_sql
ORDER BY
    nq.LogDate,
    nq.StartTime;
